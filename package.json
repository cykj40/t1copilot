{
  "name": "t1copilot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "git config core.hooksPath .githooks",
    "db:generate:neon": "turbo run db:generate:neon",
    "db:migrate:neon": "turbo run db:migrate:neon",
    "db:generate:turso": "turbo run db:generate:turso",
    "db:migrate:turso": "turbo run db:migrate:turso"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@babel/core@7.29.0": "7.29.6",
      "@tailwindcss/postcss@4.3.0>postcss": "8.5.23",
      "baseline-browser-mapping@2.10.30": "2.11.0",
      "brace-expansion@5.0.6": "5.0.9",
      "browserslist@4.28.2": "4.28.7",
      "esbuild@0.18.20": "0.25.12",
      "js-yaml@4.1.1": "4.3.2",
      "nanoid@3.3.11": "3.3.18",
      "next@15.5.25>postcss": "8.5.23",
      "next@15.5.25>sharp": "0.35.4",
      "postcss-selector-parser@7.1.1": "7.1.3",
      "shadcn@4.7.0>postcss": "8.5.23",
      "shell-quote@1.8.3": "1.9.0",
      "ws@8.20.0": "8.21.0"
    }
  }
}
